# ============================================================
# 绘梨衣 AI Core 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- LLM 配置 ---
# 兼容 OpenAI API 的提供商（DeepSeek / OpenAI / Qwen 等）
AI_LLM_BASE_URL=https://api.deepseek.com
AI_LLM_API_KEY=sk-your-api-key-here
AI_LLM_MODEL=deepseek-chat
AI_LLM_MAX_TOKENS=4096
AI_LLM_TEMPERATURE=0.7

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_PROXY=
# 国内需要代理访问 Telegram API，如 http://127.0.0.1:7890。留空则不使用代理。

# --- 数据库 ---
DATABASE_URL=sqlite+aiosqlite:///data/lianyu.db

# --- 应用 ---
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# --- 角色 ---
CHARACTER_NAME=eryi

# --- 视觉模型（read_image 工具用）---
# 主聊天模型（如 DeepSeek）不支持图片输入时，
# read_image 工具会使用独立的视觉模型来分析图片。
# 支持的视觉模型：
#   - gpt-4o / gpt-4o-mini（OpenAI，默认）
#   - qwen-vl-plus / qwen-vl-max（通义千问，base_url 填 DashScope 地址）
#   - glm-4v（智谱，base_url 填智谱 API 地址）
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_MAX_TOKENS=1024
